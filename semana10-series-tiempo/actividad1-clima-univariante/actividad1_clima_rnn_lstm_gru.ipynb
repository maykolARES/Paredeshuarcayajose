import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import fetch_openml

# Carga automática del dataset NSL-KDD desde OpenML
datos = fetch_openml("NSL-KDD", version=1, as_frame=True, parser="auto")
df = datos.frame.copy()

# Agrupamos los subtipos de ataques en las 5 categorías estándar de NSL-KDD
mapeo_ataques = {
    "normal": "Normal",
    # DoS
    "back": "DoS", "land": "DoS", "neptune": "DoS", "pod": "DoS",
    "smurf": "DoS", "teardrop": "DoS", "mailbomb": "DoS", "apache2": "DoS",
    "processtable": "DoS", "udpstorm": "DoS",
    # Probe
    "ipsweep": "Probe", "nmap": "Probe", "portsweep": "Probe",
    "satan": "Probe", "mscan": "Probe", "saint": "Probe",
    # R2L
    "ftp_write": "R2L", "guess_passwd": "R2L", "imap": "R2L",
    "multihop": "R2L", "phf": "R2L", "spy": "R2L", "warezclient": "R2L",
    "warezmaster": "R2L", "sendmail": "R2L", "named": "R2L",
    "snmpgetattack": "R2L", "snmpguess": "R2L", "xlock": "R2L",
    "xsnoop": "R2L", "worm": "R2L",
    # U2R
    "buffer_overflow": "U2R", "loadmodule": "U2R", "perl": "U2R",
    "rootkit": "U2R", "httptunnel": "U2R", "ps": "U2R",
    "sqlattack": "U2R", "xterm": "U2R"
}

df["class"] = df["class"].astype(str).str.strip().map(mapeo_ataques)

print("Dataset cargado:", df.shape)
pd.set_option("display.max_columns", None)
display(df.head())

print("Filas y columnas:", df.shape)
df.info()
print("\nTipos de datos:\n", df.dtypes.value_counts())

# Valores nulos y duplicados
nulos = df.isna().sum()
print("\nColumnas con valores nulos:\n", nulos[nulos > 0])
print("Total de valores nulos:", nulos.sum())
print("Filas repetidas:", df.duplicated().sum())
orden_clases = ["Normal", "DoS", "Probe", "R2L", "U2R"]
conteo = df["class"].value_counts().reindex(orden_clases).dropna().astype(int)
porcentaje = (conteo / len(df)) * 100

resumen_objetivo = pd.DataFrame({
    "conteo": conteo,
    "porcentaje (%)": porcentaje.round(2)
})
display(resumen_objetivo)

fig, ax = plt.subplots(figsize=(8, 5))
colores = ["#2E86AB", "#C73E1D", "#F18F01", "#A23B72", "#4C9F70"]
barras = ax.bar(conteo.index, conteo.values, color=colores)

for barra, n, p in zip(barras, conteo.values, porcentaje.values):
    ax.text(
        barra.get_x() + barra.get_width() / 2,
        barra.get_height(),
        f"{n:,}\n({p:.1f}%)",
        ha="center",
        va="bottom",
        fontsize=9
    )

ax.set_title("Distribución de la variable objetivo (Tipo de tráfico de red)")
ax.set_xlabel("Categoría de tráfico (class)")
ax.set_ylabel("Número de conexiones")
ax.set_ylim(0, conteo.max() * 1.18)
plt.tight_layout()
plt.show()
categoricas = ["protocol_type", "service", "flag"]
binarias = [
    "land", "wrong_fragment", "urgent", "hot",
    "num_failed_logins", "logged_in", "root_shell",
    "su_attempted", "num_compromised", "num_root",
    "num_file_creations", "num_shells", "num_access_files",
    "num_outbound_cmds", "is_host_login", "is_guest_login"
]

# Filtramos las que existan en el DataFrame
categoricas = [c for c in categoricas if c in df.columns]
binarias = [b for b in binarias if b in df.columns]

print("Variables categóricas:", len(categoricas), categoricas)
for c in categoricas:
    print(f"\n--- {c} (top 10) ---")
    print(df[c].value_counts(dropna=False).head(10))

print("\nVariables de conteo/indicadores de acceso:", len(binarias))
for b in binarias:
    vals = df[b].value_counts().to_dict()
    print(f"  {b}: {vals}")
excluir = set(categoricas + binarias + ["class"])
numericas = [col for col in df.columns if col not in excluir and pd.api.types.is_numeric_dtype(df[col])]

print("Variables numéricas:", len(numericas))
display(df[numericas].describe(percentiles=[0.25, 0.5, 0.75, 0.99]).round(2))

# Asimetría (skewness) para detectar colas pesadas / outliers
asimetria = df[numericas].skew().sort_values(ascending=False)
print("\nTop 10 variables numéricas con mayor asimetría:")
print(asimetria.head(10).round(2))
# B.6.1 Distribución de una variable numérica clave (con escala logarítmica por asimetría)
fig, ax = plt.subplots(figsize=(8, 4))
valores_src = np.log1p(df["src_bytes"].clip(lower=0))
ax.hist(valores_src, bins=40, color="#4C72B0", edgecolor="white")
ax.set_title("Distribución de bytes enviados al origen (log1p(src_bytes))")
ax.set_xlabel("log(1 + src_bytes)")
ax.set_ylabel("Frecuencia")
plt.tight_layout()
plt.show()

# B.6.2 Relación entre variable categórica (protocol_type) y variable objetivo (class)
conteos_proto = pd.crosstab(df["protocol_type"], df["class"])
print("\nTabla cruzada protocolo vs clase:")
display(conteos_proto)

porcentajes_proto = pd.crosstab(df["protocol_type"], df["class"], normalize="index") * 100
ax = porcentajes_proto.plot(kind="bar", stacked=True, figsize=(8, 5), colormap="Set2")
ax.set_title("Distribución de clases según tipo de protocolo (protocol_type)")
ax.set_xlabel("Protocolo de red")
ax.set_ylabel("Porcentaje (%)")
ax.legend(title="Clase", loc="upper center", bbox_to_anchor=(0.5, -0.15), ncol=5)
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()
if len(numericas) > 1:
    corr = df[numericas].corr()
    fig, ax = plt.subplots(figsize=(10, 8))
    im = ax.imshow(corr, cmap="coolwarm", vmin=-1, vmax=1)
    ax.set_xticks(range(len(numericas)))
    ax.set_yticks(range(len(numericas)))
    ax.set_xticklabels(numericas, rotation=90, fontsize=8)
    ax.set_yticklabels(numericas, fontsize=8)
    ax.set_title("Matriz de correlación (variables numéricas)")
    fig.colorbar(im, ax=ax, fraction=0.046, pad=0.04)
    plt.tight_layout()
    plt.show()
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder

# Eliminamos filas duplicadas y posibles nulos tras el mapeo
df_limpio = df.dropna(subset=["class"]).drop_duplicates().copy()

X = df_limpio.drop(columns=["class"])
y = df_limpio["class"]

# Codificamos las etiquetas ('Normal', 'DoS', 'Probe', 'R2L', 'U2R') a enteros (0 a 4)
le = LabelEncoder()
y_encoded = le.fit_transform(y)

print("Clases codificadas:", dict(zip(le.classes_, le.transform(le.classes_))))

# División estratificada 80% entrenamiento / 20% prueba (crucial por el desbalance de R2L y U2R)
X_train, X_test, y_train, y_test = train_test_split(
    X, y_encoded, test_size=0.20, random_state=42, stratify=y_encoded
)

print(f"Train shape: {X_train.shape} | Test shape: {X_test.shape}")

from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer

# Aseguramos que las listas de columnas coincidan con X_train
cols_cat = [c for c in categoricas if c in X_train.columns]
cols_num = [c for c in X_train.columns if c not in cols_cat]

# Transformador para variables numéricas/binarias
num_transformer = Pipeline(steps=[
    ("imputer", SimpleImputer(strategy="median")),
    ("scaler", StandardScaler())
])

# Transformador para variables categóricas (protocol_type, service, flag)
cat_transformer = Pipeline(steps=[
    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("onehot", OneHotEncoder(handle_unknown="ignore", sparse_output=False))
])

preprocesador = ColumnTransformer(
    transformers=[
        ("num", num_transformer, cols_num),
        ("cat", cat_transformer, cols_cat)
    ]
)

print("Preprocesador configurado correctamente.")
import time
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier, HistGradientBoostingClassifier
from sklearn.metrics import accuracy_score, f1_score, precision_score, recall_score

modelos = {
    "Logistic Regression": LogisticRegression(max_iter=1000, class_weight="balanced", random_state=42),
    "Random Forest": RandomForestClassifier(n_estimators=100, class_weight="balanced", n_jobs=-1, random_state=42),
    "HistGradientBoosting": HistGradientBoostingClassifier(max_iter=150, random_state=42)
}

resultados = []
pipelines_entrenados = {}

for nombre, modelo in modelos.items():
    inicio = time.time()
    
    clf = Pipeline(steps=[
        ("preprocessor", preprocesador),
        ("classifier", modelo)
    ])
    
    clf.fit(X_train, y_train)
    y_pred = clf.predict(X_test)
    
    duracion = time.time() - inicio
    pipelines_entrenados[nombre] = clf
    
    resultados.append({
        "Modelo": nombre,
        "Accuracy": accuracy_score(y_test, y_pred),
        "Precision (Macro)": precision_score(y_test, y_pred, average="macro", zero_division=0),
        "Recall (Macro)": recall_score(y_test, y_pred, average="macro", zero_division=0),
        "F1-Score (Macro)": f1_score(y_test, y_pred, average="macro", zero_division=0),
        "F1-Score (Weighted)": f1_score(y_test, y_pred, average="weighted", zero_division=0),
        "Tiempo (s)": round(duracion, 2)
    })

df_resultados = pd.DataFrame(resultados).sort_values(by="F1-Score (Macro)", ascending=False)
display(df_resultados.round(4))

fig, ax = plt.subplots(figsize=(9, 5))
x = np.arange(len(df_resultados))
ancho = 0.28

ax.bar(x - ancho, df_resultados["Accuracy"], width=ancho, label="Accuracy", color="#2E86AB")
ax.bar(x, df_resultados["F1-Score (Weighted)"], width=ancho, label="F1 (Weighted)", color="#4C9F70")
ax.bar(x + ancho, df_resultados["F1-Score (Macro)"], width=ancho, label="F1 (Macro)", color="#F18F01")

ax.set_xticks(x)
ax.set_xticklabels(df_resultados["Modelo"])
ax.set_ylim(0, 1.1)
ax.set_ylabel("Puntuación")
ax.set_title("Comparación de métricas por modelo en NSL-KDD")
ax.legend()
plt.tight_layout()
plt.show()
fig, ax = plt.subplots(figsize=(9, 5))
x = np.arange(len(df_resultados))
ancho = 0.28

ax.bar(x - ancho, df_resultados["Accuracy"], width=ancho, label="Accuracy", color="#2E86AB")
ax.bar(x, df_resultados["F1-Score (Weighted)"], width=ancho, label="F1 (Weighted)", color="#4C9F70")
ax.bar(x + ancho, df_resultados["F1-Score (Macro)"], width=ancho, label="F1 (Macro)", color="#F18F01")

ax.set_xticks(x)
ax.set_xticklabels(df_resultados["Modelo"])
ax.set_ylim(0, 1.1)
ax.set_ylabel("Puntuación")
ax.set_title("Comparación de métricas por modelo en NSL-KDD")
ax.legend()
plt.tight_layout()
plt.show()
from sklearn.metrics import classification_report, confusion_matrix, ConfusionMatrixDisplay

mejor_nombre = df_resultados.iloc[0]["Modelo"]
mejor_modelo = pipelines_entrenados[mejor_nombre]
y_pred_best = mejor_modelo.predict(X_test)

print(f"=== Reporte de Clasificación: {mejor_nombre} ===\n")
print(classification_report(y_test, y_pred_best, target_names=le.classes_, zero_division=0))

# Matriz de confusión normalizada por filas (Recall por clase)
fig, ax = plt.subplots(figsize=(8, 6))
cm = confusion_matrix(y_test, y_pred_best, normalize="true")
disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=le.classes_)
disp.plot(cmap="Blues", values_format=".2f", ax=ax)
ax.set_title(f"Matriz de Confusión Normalizada - {mejor_nombre}")
plt.tight_layout()
plt.show()
# Extraemos importancia de variables usando Random Forest
rf_pipe = pipelines_entrenados["Random Forest"]
nombres_features = rf_pipe.named_steps["preprocessor"].get_feature_names_out()
importancias = rf_pipe.named_steps["classifier"].feature_importances_

df_imp = pd.DataFrame({
    "Feature": [f.replace("num__", "").replace("cat__", "") for f in nombres_features],
    "Importancia": importancias
}).sort_values(by="Importancia", ascending=False).head(15)

fig, ax = plt.subplots(figsize=(9, 5))
ax.barh(df_imp["Feature"][::-1], df_imp["Importancia"][::-1], color="#2E86AB")
ax.set_title("Top 15 variables más importantes para detectar intrusiones (Random Forest)")
ax.set_xlabel("Importancia relativa")
plt.tight_layout()
plt.show()
## E. Conclusiones

1. **Desbalanceo de clases y elección de métricas:** En el dataset **NSL-KDD**, las clases mayoritarias (`Normal` y `DoS`) concentran la mayor parte del tráfico, mientras que ataques complejos como `R2L` y `U2R` representan menos del 1% de las conexiones. Por ello, el **F1-Score Macro** resulta más informativo que el *Accuracy* global para evaluar la capacidad real del sistema de detectar intrusiones críticas poco frecuentes.
2. **Desempeño de modelos:** Los modelos basados en ensambles de árboles (**Random Forest** e **HistGradientBoosting**) superan ampliamente a la **Regresión Logística**, capturando interacciones no lineales entre el protocolo de red, los flags de conexión y el volumen de bytes transferidos (`src_bytes`, `dst_bytes`).
3. **Variables determinantes:** El análisis de importancia de características confirma que el volumen de bytes enviados/recibidos, la tasa de errores de conexión (`serror_rate`), el servicio solicitado (`http`, `private`, `ecr_i`) y el estado de inicio de sesión (`logged_in`) son los indicadores principales para discriminar tráfico legítimo frente a ataques de red.
